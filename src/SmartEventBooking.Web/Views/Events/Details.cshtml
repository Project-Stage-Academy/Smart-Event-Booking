@model SmartEventBooking.Application.DTOs.Detail.DetailsDto
@using SmartEventBooking.Web.Extensions

@{
    ViewData["Title"] = "Деталі події";
}

<div class="container mt-5">

    <div class="card shadow-sm">

        <div class="card-header bg-primary text-white">
            <h2 class="mb-0">@Model.Title</h2>
        </div>

        <div class="card-body">

           
            @if (!string.IsNullOrEmpty(Model.Banner))
            {
                <img src="@Model.Banner"
                     class="img-fluid mb-3 rounded"
                     style="max-height:350px; object-fit:cover;" />
            }

            <h5>Опис</h5>
            <p>@Model.Description</p>

            <hr />

            <p><strong>Статус:</strong> @Model.Status.GetDisplayName()</p>

            <p><strong>Початок:</strong> @Model.StartDateTime.ToString("dd.MM.yyyy HH:mm")</p>
            <p><strong>Завершення:</strong> @Model.EndDateTime.ToString("dd.MM.yyyy HH:mm")</p>

            <hr />

            <p><strong>Максимальна кількість місць:</strong> @Model.TotalCapacity</p>
            <p><strong>Вільні місця:</strong> @Model.AvailableSeats</p>

            <p><strong>Ціна:</strong> @Model.Price</p>

            <hr />

            <p><strong>Venue ID:</strong> @Model.VenueId</p>

        </div>

        <div class="card-footer d-flex justify-content-between">

            <a asp-action="Index" class="btn btn-secondary">
                ← Назад
            </a>

            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">
                Редагувати
            </a>

        </div>

    </div>

</div>