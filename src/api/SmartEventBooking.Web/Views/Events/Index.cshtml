@model IEnumerable<SmartEventBooking.Application.DTOs.Event.EventDto>

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold">Події</h2>

        <a asp-action="Create" class="btn btn-primary">
            Створити подію
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["Success"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>
        </div>
    }

    <div class="row g-4">

        @foreach (var item in Model)
        {
            <div class="col-md-6 col-lg-4">

                <div class="card event-card h-100">

                    <div class="card-body d-flex flex-column">

                        <h5 class="event-title mb-2">
                            @item.Title
                        </h5>

                        <div class="event-date mb-3">
                            📅 @item.StartDateTime.ToString("dd.MM.yyyy HH:mm")
                        </div>

                        <div class="mt-auto d-flex gap-2">

                            <a asp-action="Details"
                                   asp-route-id="@item.Id"
                                   class="btn btn-sm btn-outline-info flex-fill">
                                Деталі
                            </a>

                            <a asp-action="Edit"
                                   asp-route-id="@item.Id"
                                   class="btn btn-sm btn-outline-warning flex-fill">
                                Редагувати
                            </a>

                        </div>

                        <form asp-action="Delete"
                              asp-route-id="@item.Id"
                              method="post"
                              class="mt-2">

                            <button type="submit"
                                    class="btn btn-sm btn-outline-danger w-100"
                                    onclick="return confirm('Ви впевнені?')">
                                Видалити
                            </button>

                        </form>

                    </div>
                </div>

            </div>
        }

    </div>
</div>